# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quoteos"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for scheduled jobs (e.g. POST /api/cron/abandon)
CRON_SECRET="replace-me"

# Providers (all optional - console/log providers are used when unset)
EMAIL_PROVIDER="console"          # console | resend
RESEND_API_KEY=""
EMAIL_FROM="QuoteOS <quotes@example.com>"
AI_PROVIDER="heuristic"           # heuristic | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
